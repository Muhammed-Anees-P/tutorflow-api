  "info": {
    "title": "TutorFlow API",
    "description": "API documentation",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Enter registered username of the user"
          },
          "password": {
            "type": "string",
            "description": "Enter password of the user"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Unique username",
            "example": "john_doe"
          },
          "firstName": {
            "type": "string",
            "description": "First name",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "description": "Last name",
            "example": "Doe"
          },
          "email": {
            "type": "string",
            "description": "Email address",
            "example": "john@example.com"
          },
          "phone": {
            "type": "string",
            "description": "Phone number",
            "example": "+1234567890"
          },
          "password": {
            "type": "string",
            "description": "Password",
            "minLength": 6
          },
          "role": {
            "type": "string",
            "description": "User role",
            "enum": [
              "TUTOR",
              "STUDENT"
            ],
            "default": "STUDENT"
          },
          "isActive": {
            "type": "boolean",
            "description": "Is user active",
            "default": true
          }
        },
        "required": [
          "username",
          "firstName",
          "password",
          "role",
          "isActive"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "Unique username",
            "example": "john_doe"
          },
          "firstName": {
            "type": "string",
            "description": "First name",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "description": "Last name",
            "example": "Doe"
          },
          "email": {
            "type": "string",
            "description": "Email address",
            "example": "john@example.com"
          },
          "phone": {
            "type": "string",
            "description": "Phone number",
            "example": "+1234567890"
          },
          "password": {
            "type": "string",
            "description": "Password",
            "minLength": 6
          },
          "role": {
            "type": "string",
            "description": "User role",
            "enum": [
              "TUTOR",
              "STUDENT"
            ],
            "default": "STUDENT"
          },
          "isActive": {
            "type": "boolean",
            "description": "Is user active",
            "default": true
          }
        }
      },
      "CreateStudentDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Student name",
            "example": "Sarah Johnson"
          },
          "email": {
            "type": "string",
            "description": "Student email",
            "example": "sarah@example.com"
          },
          "password": {
            "type": "string",
            "description": "Temporary password",
            "example": "TempPass123!"
          },
          "subject": {
            "type": "string",
            "description": "Subject",
            "example": "Mathematics"
          },
          "currentLevel": {
            "type": "string",
            "description": "Current level",
            "example": "Grade 8"
          },
          "learningGoals": {
            "description": "Learning goals",
            "example": [
              "Improve algebra fundamentals"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "weakAreas": {
            "description": "Weak areas",
            "example": [
              "Linear equations"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "email",
          "password",
          "subject",
          "currentLevel",
          "learningGoals",
          "weakAreas"
        ]
      },
      "UpdateStudentDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Student name",
            "example": "Sarah Johnson"
          },
          "email": {
            "type": "string",
            "description": "Student email",
            "example": "sarah@example.com"
          },
          "password": {
            "type": "string",
            "description": "Temporary password",
            "example": "TempPass123!"
          },
          "subject": {
            "type": "string",
            "description": "Subject",
            "example": "Mathematics"
          },
          "currentLevel": {
            "type": "string",
            "description": "Current level",
            "example": "Grade 8"
          },
          "learningGoals": {
            "description": "Learning goals",
            "example": [
              "Improve algebra fundamentals"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "weakAreas": {
            "description": "Weak areas",
            "example": [
              "Linear equations"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateSessionDto": {
        "type": "object",
        "properties": {
          "studentId": {
            "type": "string",
            "description": "Student ID",
            "example": "507f1f77bcf86cd799439011"
          },
          "scheduledAt": {
            "type": "string",
            "description": "Date and time",
            "example": "2026-09-02T10:00:00Z"
          },
          "topic": {
            "type": "string",
            "description": "Session topic",
            "example": "Linear Equations"
          }
        },
        "required": [
          "studentId",
          "scheduledAt",
          "topic"
        ]
      },
      "UpdateSessionDto": {
        "type": "object",
        "properties": {}
      },
      "UpdateNotesDto": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "string",
            "description": "Session notes content",
            "example": "Today we covered linear equations..."
          }
        }
      }
    }
  }
